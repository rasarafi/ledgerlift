APP_NAME=ledgerlift
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8092

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Compose MySQL is published on host port 3317. Destructive artisan commands
# are blocked unless the database name ends in `_test` (see AppServiceProvider).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3317
DB_DATABASE=ledgerlift_new_test
DB_USERNAME=root
DB_PASSWORD=ledgerlift

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# Parity-test targets: the legacy InvoicePlane and the new app, each on its own database.
LEGACY_URL=http://localhost:8091
NEW_URL=http://localhost:8092
LEGACY_DB=ledgerlift_legacy_test
NEW_DB=ledgerlift_new_test
